# Local/staging Directus settings. Copy to .env and replace every placeholder.
POSTGRES_USER=directus
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=directus

DIRECTUS_PORT=8055
DIRECTUS_KEY=replace-with-a-32-character-random-key
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-random-password
DIRECTUS_PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:8080

# Leave blank for local email/password testing.
# Enable only after Google OAuth credentials are created for the staging URL.
AUTH_PROVIDERS=
AUTH_GOOGLE_DRIVER=openid
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ISSUER_URL=https://accounts.google.com
AUTH_GOOGLE_IDENTIFIER_KEY=email
